# ============================================================================
#  memecoin-sniper — configuration
#  Copy to .env and edit. Every value below is the built-in default.
#  An empty value (e.g. `MODE=`) means "use the default", not "zero".
# ============================================================================

# ---- mode ------------------------------------------------------------------
# paper = never signs a transaction, but reads real chain state and prices.
# live  = real funds. Run `npm run doctor` and a long paper session first.
MODE=paper
LOG_LEVEL=info

# ---- connectivity ----------------------------------------------------------
# The single highest-leverage setting in this file. A public endpoint sees new
# launches hundreds of milliseconds after a dedicated one, and in that window
# the trade is already gone. List several: the bot subscribes to all of them at
# once and acts on whichever reports first.
RPC_HTTP=https://api.mainnet-beta.solana.com
# Optional, index-matched to RPC_HTTP. Leave blank to derive ws:// from http://.
RPC_WS=

# Endpoints used only to broadcast. Defaults to RPC_HTTP when unset. Dedicated
# staked-connection senders belong here.
SEND_RPC_HTTP=

# ---- jito ------------------------------------------------------------------
# Bundles buy inclusion during congestion, at the cost of the tip. Worth it on
# contested launches, wasteful on quiet ones.
JITO_ENABLED=false
JITO_ENDPOINTS=https://mainnet.ny.block-engine.jito.wtf/api/v1/bundles,https://amsterdam.mainnet.block-engine.jito.wtf/api/v1/bundles,https://frankfurt.mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TIP_LAMPORTS=200000

# ---- wallet ----------------------------------------------------------------
# base58 secret key, or a path to a solana-keygen JSON file.
# Use a dedicated wallet funded with only what this bot may lose.
WALLET_SECRET=

# ---- detection -------------------------------------------------------------
WATCH_PUMPFUN=true
WATCH_RAYDIUM=true
# Hard ceiling on pre-trade analysis. Raising it buys better filtering and
# loses the race; lowering it does the reverse. 100-150ms is the usable band.
HOT_FILTER_BUDGET_MS=120

# ---- entry -----------------------------------------------------------------
BUY_LAMPORTS=20000000
BUY_SLIPPAGE_BPS=1500
MAX_CONCURRENT_POSITIONS=3
MAX_EVENT_AGE_MS=2500
# 0..1. Raise it to trade less and better. Below ~0.5 the filter is decorative.
MIN_SCORE=0.55

# ---- fees ------------------------------------------------------------------
CU_LIMIT_BUY=120000
CU_LIMIT_SELL=140000
# Floor, in micro-lamports per compute unit. The oracle raises this to the
# network's p75 automatically and escalates it further on exit retries.
PRIORITY_FEE_MICROLAMPORTS=500000
PRIORITY_FEE_MAX_MICROLAMPORTS=8000000

# ---- exits -----------------------------------------------------------------
# "multiple:fraction_of_bag", applied in ascending order. Fractions sum to <= 1.
TP_LADDER=1.6:0.35,2.5:0.3,5:0.2,10:0.15
TRAILING_STOP_PCT=0.28
TRAILING_ARM_MULTIPLE=1.4
HARD_STOP_PCT=0.45
MAX_HOLD_MS=180000
STAGNATION_MS=45000
STAGNATION_BAND_PCT=0.08
PRICE_POLL_MS=700

# ---- risk ------------------------------------------------------------------
# Realised loss that halts trading for the rest of the UTC day.
DAILY_LOSS_LIMIT_LAMPORTS=300000000
MAX_EXPOSURE_LAMPORTS=120000000
CONSECUTIVE_LOSS_COOLDOWN=3
COOLDOWN_MS=300000
# Never spend the wallet below this; it pays for the exits.
MIN_WALLET_RESERVE_LAMPORTS=30000000

# ---- persistence -----------------------------------------------------------
STATE_DIR=./state
